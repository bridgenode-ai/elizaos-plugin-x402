# ── Required ──────────────────────────────────────────────────────────────
# Agent wallet private key (base58). Must have a USDC ATA on Solana mainnet
# (first USDC transfer auto-creates it). BridgeNode sponsors gas fees.
SOLANA_PRIVATE_KEY=

# ── Optional ──────────────────────────────────────────────────────────────
# Solana RPC endpoint used for payment settlement (default: mainnet-beta).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# BridgeNode endpoint (default: https://bridgenode.cc/v1)
BRIDGENODE_BASE_URL=https://bridgenode.cc/v1

# Max USDC per transaction (default: 1). Safety cap — user configurable (S2).
BRIDGENODE_MAX_USDC_PER_TX=1

# Model overrides (defaults verified live against /v1/models on 2026-08-23)
BRIDGENODE_MODEL_SMALL=deepseek-v4-flash
BRIDGENODE_MODEL_LARGE=glm-5.2
